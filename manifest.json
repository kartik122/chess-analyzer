{
  "manifest_version": 3,
  "name": "Chess.com Post-Game Analyzer",
  "version": "0.1.0",
  "description": "Analyze your chess.com game with a client-side Stockfish engine after it ends. No live-game assistance.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.chess.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["content/game-over-detector.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/*", "analysis.html"],
      "matches": ["https://www.chess.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
